# Discord application credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Bot-level privileged IDs. Comma-separated Discord user IDs.
# These are the ONLY users who receive bot owner/admin permissions.
BOT_OWNER_IDS=
BOT_ADMIN_IDS=

# Economy defaults
CURRENCY_NAME=Coins
CURRENCY_SYMBOL=🪙
STARTING_BALANCE=100
DAILY_REWARD=500

# Optional database path for the starter local JSON store
DATA_FILE=./data/economy.json
